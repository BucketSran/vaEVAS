# OpenVAF-Reloaded build (issue #200 R4). Source: git clone --depth 1 https://github.com/OpenVAF-Reloaded/OpenVAF.git @ 5063fdadc254842cdf16112241d6df81fde48d43 (2026-10-14),
# vendored with cargo vendor (container has no github access); deps pre-fetched. See RECEIPTS.md R4.
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl git ca-certificates pkg-config clang-18 llvm-18-dev libclang-18-dev libpolly-18-dev llvm-18 \
    && rm -rf /var/lib/apt/lists/* || (apt-get update && apt-get install -y --no-install-recommends build-essential curl git ca-certificates pkg-config clang-18 llvm-18-dev libclang-18-dev && rm -rf /var/lib/apt/lists/*)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --profile minimal
ENV PATH=/root/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV LLVM_SYS_181_PREFIX=/usr/lib/llvm-18
COPY OpenVAF /src
RUN ln -sf /usr/bin/clang-18 /usr/local/bin/clang && ln -sf /usr/lib/llvm-18/bin/llvm-lib /usr/local/bin/llvm-lib && ln -sf /usr/lib/llvm-18/bin/llvm-dlltool /usr/local/bin/llvm-dlltool && ln -sf /usr/bin/llvm-config-18 /usr/local/bin/llvm-config
WORKDIR /src
RUN cargo build --release --features llvm18 --bin openvaf-r
RUN cp target/release/openvaf-r /usr/local/bin/ && ln -sf /usr/local/bin/openvaf-r /usr/local/bin/openvaf && openvaf --version
