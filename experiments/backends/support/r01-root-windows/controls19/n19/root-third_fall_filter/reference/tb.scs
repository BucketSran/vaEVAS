simulator lang=spectre
ahdl_include "dut.va"
Vu (u 0) vsource type=pwl wave=[0 3 1 0]
dut (u y z w 0) m
simulatorOptions options precision="%.17g" reltol=1e-9 vabstol=1e-12 iabstol=1e-15
tran tran stop=1 maxstep=0.0078125 method=traponly errpreset=conservative compression=no strobeoutput=all strobetimes=[0 0.125 0.25 0.375 0.5 0.625 0.75 0.875 1]
save u y z w
