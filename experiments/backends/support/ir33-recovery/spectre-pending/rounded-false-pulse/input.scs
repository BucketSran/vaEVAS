simulator lang=spectre
ahdl_include "model.va"
dut (s r y) m
Vs (s 0) vsource type=pwl wave=[0 -1 0.5 0.5 1 -1 6 -1]
Vr (r 0) vsource type=pwl wave=[0 0 6 0]
opts options reltol=1e-6 vabstol=1e-9 iabstol=1e-12
tran tran stop=6 maxstep=0.01 errpreset=conservative strobeoutput=all strobetimes=[0 0.25 0.5 0.75 1 5]
save y
