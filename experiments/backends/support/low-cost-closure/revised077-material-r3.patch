+def root_bracket(index, dt):
+    """Adjacent binary64 numbers enclosing exact decimal parameter n*dt."""
+    root = Fraction(str(dt)) * index
+    rounded = float(root)
+    value = Fraction.from_float(rounded)
+    return (math.nextafter(rounded, -math.inf) if value > root else rounded,
+            math.nextafter(rounded, math.inf) if value < root else rounded)
 
 
