+def row_intervals(time, dt):
+    # Only at the enclosing floats may the trace observe either event side.
+    n = max(0, int(Fraction.from_float(time) // Fraction(str(dt))))
+    for k in (n, n + 1):
+        if k > 0:
+            lo, hi = root_bracket(k, dt)
+            if lo <= time <= hi:
+                return (k - 1, k)
+    return (n,)
 
 
