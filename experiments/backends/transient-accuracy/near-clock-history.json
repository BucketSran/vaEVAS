      "sample_slope": "`include \"disciplines.vams\"\nmodule m(u,y,r,z); input u; output y,z; inout r; electrical u,y,r,z; integer n,m,h; real s; analog begin @(initial_step) begin n=0; m=0; h=0; s=0; end\n @(timer(2e-6,2e-6,1e-12)) n=n+1;\n @(timer(3e-6,3e-6,1e-12)) begin m=m+1; s=V(z,r); end\n V(z,r)<+idt(1e6*(n+10*m),0);\n @(cross(V(z,r)-100.0,1,1e-12,1e-7)) h=h+1;\n V(y,r)<+s; end endmodule\n"
