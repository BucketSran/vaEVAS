      "guard100": "`include \"disciplines.vams\"\nmodule m(u,y,r,z); input u; output y,z; inout r; electrical u,y,r,z; integer n,m,h; analog begin @(initial_step) begin n=0; m=0; h=0;  end\n @(timer(2e-6,2e-6,1e-12)) n=n+1;\n @(timer(3e-6,3e-6,1e-12)) m=m+1;\n V(z,r)<+idt(1e6*n,0);\n @(cross(V(z,r)-100.0,1,1e-12,1e-7)) h=h+1;\n V(y,r)<+n+10*m+100*h; end endmodule\n",
