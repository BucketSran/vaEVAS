`include "disciplines.vams"
module chain_downstream(clk,resetb,enable,activity);
input clk,resetb,enable; output activity; electrical clk,resetb,enable,activity;
integer count; parameter real tr=10p;
analog begin
@(initial_step) count=0;
@(cross(V(resetb)-.45,-1) or cross(V(enable)-.45,-1)) count=0;
@(cross(V(clk)-.45,1)) begin
if(V(resetb)>.45 && V(enable)>.45) count=count+1; else count=0;
end
V(activity)<+transition(.1*count,0,tr);
end
endmodule
