analog begin
@(initial_step) begin vinit=V(vin); gateinit=1.8-V(clock); end
if(V(vin)<=0.2) correction=adjust0(V(vhold));
else if(V(vin)<=0.25) correction=adjust0(V(vhold))+(adjust1(V(vhold))-adjust0(V(vhold)))*(V(vin)-0.2)/0.05;
else if(V(vin)<=0.3) correction=adjust1(V(vhold))+(adjust2(V(vhold))-adjust1(V(vhold)))*(V(vin)-0.25)/0.05;
else if(V(vin)<=0.35) correction=adjust2(V(vhold))+(adjust3(V(vhold))-adjust2(V(vhold)))*(V(vin)-0.3)/0.05;
else if(V(vin)<=0.4) correction=adjust3(V(vhold))+(adjust4(V(vhold))-adjust3(V(vhold)))*(V(vin)-0.35)/0.05;
else if(V(vin)<=0.45) correction=adjust4(V(vhold))+(adjust5(V(vhold))-adjust4(V(vhold)))*(V(vin)-0.4)/0.05;
else if(V(vin)<=0.5) correction=adjust5(V(vhold))+(adjust6(V(vhold))-adjust5(V(vhold)))*(V(vin)-0.45)/0.05;
else if(V(vin)<=0.55) correction=adjust6(V(vhold))+(adjust7(V(vhold))-adjust6(V(vhold)))*(V(vin)-0.5)/0.05;
else if(V(vin)<=0.6) correction=adjust7(V(vhold))+(adjust8(V(vhold))-adjust7(V(vhold)))*(V(vin)-0.55)/0.05;
else if(V(vin)<=0.65) correction=adjust8(V(vhold))+(adjust9(V(vhold))-adjust8(V(vhold)))*(V(vin)-0.6)/0.05;
else if(V(vin)<=0.7) correction=adjust9(V(vhold))+(adjust10(V(vhold))-adjust9(V(vhold)))*(V(vin)-0.65)/0.05;
else if(V(vin)<=0.75) correction=adjust10(V(vhold))+(adjust11(V(vhold))-adjust10(V(vhold)))*(V(vin)-0.7)/0.05;
else if(V(vin)<=0.8) correction=adjust11(V(vhold))+(adjust12(V(vhold))-adjust11(V(vhold)))*(V(vin)-0.75)/0.05;
else if(V(vin)<=0.85) correction=adjust12(V(vhold))+(adjust13(V(vhold))-adjust12(V(vhold)))*(V(vin)-0.8)/0.05;
else if(V(vin)<=0.9) correction=adjust13(V(vhold))+(adjust14(V(vhold))-adjust13(V(vhold)))*(V(vin)-0.85)/0.05;
else if(V(vin)<=0.95) correction=adjust14(V(vhold))+(adjust15(V(vhold))-adjust14(V(vhold)))*(V(vin)-0.9)/0.05;
else if(V(vin)<=1) correction=adjust15(V(vhold))+(adjust16(V(vhold))-adjust15(V(vhold)))*(V(vin)-0.95)/0.05;
else if(V(vin)<=1.05) correction=adjust16(V(vhold))+(adjust17(V(vhold))-adjust16(V(vhold)))*(V(vin)-1)/0.05;
else if(V(vin)<=1.1) correction=adjust17(V(vhold))+(adjust18(V(vhold))-adjust17(V(vhold)))*(V(vin)-1.05)/0.05;
else if(V(vin)<=1.15) correction=adjust18(V(vhold))+(adjust19(V(vhold))-adjust18(V(vhold)))*(V(vin)-1.1)/0.05;
else if(V(vin)<=1.2) correction=adjust19(V(vhold))+(adjust20(V(vhold))-adjust19(V(vhold)))*(V(vin)-1.15)/0.05;
else if(V(vin)<=1.25) correction=adjust20(V(vhold))+(adjust21(V(vhold))-adjust20(V(vhold)))*(V(vin)-1.2)/0.05;
else if(V(vin)<=1.3) correction=adjust21(V(vhold))+(adjust22(V(vhold))-adjust21(V(vhold)))*(V(vin)-1.25)/0.05;
else if(V(vin)<=1.35) correction=adjust22(V(vhold))+(adjust23(V(vhold))-adjust22(V(vhold)))*(V(vin)-1.3)/0.05;
else if(V(vin)<=1.4) correction=adjust23(V(vhold))+(adjust24(V(vhold))-adjust23(V(vhold)))*(V(vin)-1.35)/0.05;
else if(V(vin)<=1.45) correction=adjust24(V(vhold))+(adjust25(V(vhold))-adjust24(V(vhold)))*(V(vin)-1.4)/0.05;
else if(V(vin)<=1.5) correction=adjust25(V(vhold))+(adjust26(V(vhold))-adjust25(V(vhold)))*(V(vin)-1.45)/0.05;
else if(V(vin)<=1.55) correction=adjust26(V(vhold))+(adjust27(V(vhold))-adjust26(V(vhold)))*(V(vin)-1.5)/0.05;
else if(V(vin)<=1.6) correction=adjust27(V(vhold))+(adjust28(V(vhold))-adjust27(V(vhold)))*(V(vin)-1.55)/0.05;
else correction=adjust28(V(vhold));
target=1.8-V(clock);
tau=(target>V(invstate)) ? 0.09e-9 : 0.08e-9;
rate=correction*(channel_n(V(vin),V(vhold),V(invstate))+channel_p(V(vin),V(vhold),V(clock)));
V(invstate) <+ idt((target-V(invstate))/tau,gateinit);
V(vhold) <+ idt(rate*(V(vin)-V(vhold))*1e9,0.0,V(clock)>0.9 ? 1 : 0);
$bound_step(5p);
end
endmodule
