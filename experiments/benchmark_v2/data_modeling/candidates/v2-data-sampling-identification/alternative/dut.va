analog begin
@(initial_step) begin vinit=V(vin); gateinit=1.8-V(clock); end
if(V(vin)<=0.2) correction=adjust0(V(state));
else if(V(vin)<=0.3) correction=adjust0(V(state))+(adjust1(V(state))-adjust0(V(state)))*(V(vin)-0.2)/0.1;
else if(V(vin)<=0.4) correction=adjust1(V(state))+(adjust2(V(state))-adjust1(V(state)))*(V(vin)-0.3)/0.1;
else if(V(vin)<=0.5) correction=adjust2(V(state))+(adjust3(V(state))-adjust2(V(state)))*(V(vin)-0.4)/0.1;
else if(V(vin)<=0.6) correction=adjust3(V(state))+(adjust4(V(state))-adjust3(V(state)))*(V(vin)-0.5)/0.1;
else if(V(vin)<=0.7) correction=adjust4(V(state))+(adjust5(V(state))-adjust4(V(state)))*(V(vin)-0.6)/0.1;
else if(V(vin)<=0.8) correction=adjust5(V(state))+(adjust6(V(state))-adjust5(V(state)))*(V(vin)-0.7)/0.1;
else if(V(vin)<=0.9) correction=adjust6(V(state))+(adjust7(V(state))-adjust6(V(state)))*(V(vin)-0.8)/0.1;
else if(V(vin)<=1) correction=adjust7(V(state))+(adjust8(V(state))-adjust7(V(state)))*(V(vin)-0.9)/0.1;
else if(V(vin)<=1.1) correction=adjust8(V(state))+(adjust9(V(state))-adjust8(V(state)))*(V(vin)-1)/0.1;
else if(V(vin)<=1.2) correction=adjust9(V(state))+(adjust10(V(state))-adjust9(V(state)))*(V(vin)-1.1)/0.1;
else if(V(vin)<=1.3) correction=adjust10(V(state))+(adjust11(V(state))-adjust10(V(state)))*(V(vin)-1.2)/0.1;
else if(V(vin)<=1.4) correction=adjust11(V(state))+(adjust12(V(state))-adjust11(V(state)))*(V(vin)-1.3)/0.1;
else if(V(vin)<=1.5) correction=adjust12(V(state))+(adjust13(V(state))-adjust12(V(state)))*(V(vin)-1.4)/0.1;
else if(V(vin)<=1.6) correction=adjust13(V(state))+(adjust14(V(state))-adjust13(V(state)))*(V(vin)-1.5)/0.1;
else correction=adjust14(V(state));
target=1.8-V(clock);
tau=(target>V(invstate)) ? 0.09e-9 : 0.08e-9;
rate=correction*(channel_n(V(vin),V(state),V(invstate))+channel_p(V(vin),V(state),V(clock)));
I(invstate) <+ 1e-12*ddt(V(invstate));
I(invstate) <+ 1e-12*(V(invstate)-target)/tau;
I(state) <+ 1e-12*ddt(V(state));
I(state) <+ rate*(V(state)-V(vin))*1e-3;
V(vhold) <+ V(state);
$bound_step(5p);
end
endmodule
