`include "constants.vams"
`include "disciplines.vams"
module sampling_model(vin, clock, vhold);
input vin, clock; output vhold;
electrical vin, clock, vhold, invstate, state;
real vinit, gateinit, correction, rate, target, tau;
analog function real channel_n;
input u,y,g; real u,y,g;
real lo,hi,delta,over,drain;
begin
lo=min(u,y); hi=max(u,y); delta=hi-lo;
over=max(0.0,g-lo-0.9-5.74525975682e-20*(sqrt(0.7+lo)-sqrt(0.7)));
drain=min(delta,over);
if(delta>1e-8) channel_n=8.68950768676*(over-0.5*drain)*drain/delta*(1.0+1.90820421815e-22*delta)/(1.0+2.15815474565*over);
else channel_n=8.68950768676*over/(1.0+2.15815474565*over);
end
endfunction
analog function real channel_p;
input u,y,g; real u,y,g;
real lo,hi,delta,over,drain;
begin
lo=min(u,y); hi=max(u,y); delta=hi-lo;
over=max(0.0,hi-g-0.2-1.46884482886*(sqrt(2.5-hi)-sqrt(0.7)));
drain=min(delta,over);
if(delta>1e-8) channel_p=0.34283938012*(over-0.5*drain)*drain/delta*(1.0+0.0413635387959*delta)/(1.0+1.08093547196e-19*over);
else channel_p=0.34283938012*over/(1.0+1.08093547196e-19*over);
end
endfunction
