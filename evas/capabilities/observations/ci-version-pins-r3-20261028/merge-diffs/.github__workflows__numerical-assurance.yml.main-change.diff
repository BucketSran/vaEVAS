+# One fixed Rust toolchain for every job that builds or records stable Rust. rustup applies it
+# to plain cargo and rustc, and to the scripts that record the toolchain; change it only for a
+# deliberate upgrade. A reusable workflow does not inherit this env: selection exports the value
+# as an output and package passes it to package-install.yml as an input, so no copy exists.
+# Exception: fuzz-smoke installs and names the nightly channel, which cargo-fuzz requires.
+env:
+  RUSTUP_TOOLCHAIN: '1.99.1'
+
 concurrency:
   group: numerical-assurance-${{ github.event_name }}-${{ github.event.pull_request.number || github.run_id }}
