+            'kind': 'requirement',
+            'bound': False,
+        }])
+        self.assertEqual(consumer['execution']['value'], 'passed')
+        self.assertIn('未绑定引用：kind requirement `fixture-requirement`', text)
+        self.assertIn('bound false', text)
