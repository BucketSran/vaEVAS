+    def test_revoked_dependency_changes_json_and_markdown(self):
+        data = retarget(fixture(), 'evas')
+        before, before_text = checked(Registry(data))
+        before_json = dumps(before)
+        old_sha = digest(by_id(data, 'checker'))
