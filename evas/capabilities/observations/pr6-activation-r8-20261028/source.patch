+                    found = historical_checked_calls(self.tree(tmp, dict(strict, **{'scripts/context_reader.py': helper})))
+                if passes:
+                    self.assertEqual(found, single)
+                else:
+                    self.assertIn('scripts/context_reader.py', {path for path, _function, _details in found})
