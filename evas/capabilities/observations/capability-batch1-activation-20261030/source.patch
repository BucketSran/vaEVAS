+        for last, accepted in [(CAP - 1, True), (CAP, False)]:
+            end = last * STEP
+            self.assertEqual(int(F(end) // F(STEP)) + 1, last + 1)
+            with self.subTest(points=last + 1):
+                if accepted:
+                    self.assertEqual(len(strobe.expand(1.0, strobeperiod=STEP, skipstop=end)), CAP)
+                else:
