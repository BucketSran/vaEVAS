+            analytic_sources: vec![],
+            pwl_errors_v: None,
+            strobetimes: (1..=strobes).map(|k| k as f64 / count).collect(),
+            pwl: vec![vec![[0.0, 0.0], [1.0, 1.0]]],
+            output_times: vec![0.0, 1.0],
+            stop: 1.0,
+            max_step: 1.0,
+            proof_work_limit: limit,
+        }
+    }
