  "schema_version": 1,
  "id": "precision-engineering-v1",
  "claim": "Finite external engineering acceptance of four sample-hold and four first-order conditions; not all-domain support or a held-out publication suite",
  "denominator": 8,
  "budgets": {
    "absolute_V": 1e-08,
    "relative": 1e-06,
    "input_absolute_V": 1e-10,
    "input_relative": 1e-08,
