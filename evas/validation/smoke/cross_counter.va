module cross_counter(vin, count, vref);
  input vin;
  output count;
  inout vref;
  electrical vin, count, vref;
  integer rising, falling;
  analog begin
    @(initial_step) begin rising=0; falling=0; end
    @(cross(V(vin,vref)-.5, +1, 100p, 100u)) rising=rising+1;
    @(cross(V(vin,vref)-.5, -1, 100p, 100u)) falling=falling+1;
    V(count,vref) <+ .1*rising + .01*falling;
  end
endmodule
