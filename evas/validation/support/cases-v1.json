      "id": "LANG-functions",
      "family": "functions",
      "source": "`include \"disciplines.vams\"\nmodule probe(u,y,z);\ninput u; output y,z; electrical u,y,z;\nparameter real vss=0, vdd=0.9;\n// The clip body is retained from the PA AM/PM memory-tap benchmark function.\nanalog function real clip;\ninput x; real x;\nbegin if(x<vss) clip=vss; else if(x>vdd) clip=vdd; else clip=x; end\nendfunction\n// A condition must capture t before the selected branch changes it.\nanalog function real sequenced;\ninput x; real x,t;\nbegin\n  t=x; sequenced=0;\n  if(t>0.5) begin t=-t; sequenced=1; end\n  sequenced=sequenced+t;\nend endfunction\nanalog begin\nV(y)<+clip(V(u));\nV(z)<+sequenced(V(u));\nend\nendmodule\n",
      "top": "probe",
      "parameters": {},
      "inputs": {
