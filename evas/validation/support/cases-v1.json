    {
      "id": "LANG-array-events",
      "family": "loop_array",
      "source": "`include \"disciplines.vams\"\nmodule probe(u,y,qzero,qone,qlast,r);\ninput u; output y,qzero,qone,qlast; inout r;\nelectrical u,y,qzero,qone,qlast,r;\nparameter integer N=2;\nparameter real SEED=0, POLLUTE=40;\nreal q[0:N-1];\ngenvar i;\nanalog begin\n  @(initial_step or cross(V(u,r)-0.5,1,1e-9,1e-12))\n    for(i=0;i<N;i=i+1) q[i]=SEED+i;\n  @(timer(0.25,0,1e-9))\n    for(i=0;i<N;i=i+1) q[i]=POLLUTE+i;\n  for(i=0;i<N;i=i+1) V(y,r)<+q[i];\n  V(qzero,r)<+q[0];\n  V(qone,r)<+q[1];\n  V(qlast,r)<+q[N-1];\nend\nendmodule\n",
      "top": "probe",
