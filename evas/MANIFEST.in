include setup.py
include rust_core/Cargo.toml rust_core/Cargo.lock
recursive-include rust_core/src *.rs
recursive-include rust_core/benches *.rs
include rust_core/ir/Cargo.toml
recursive-include rust_core/ir/src *.rs
prune rust_core/target
prune build
recursive-exclude src/evas/_bin *
include rust_core/fuzz/seeds/static.json
include tests/fixtures/implicit-event-restart/program.json
include rust_core/fuzz/seeds/static.va
recursive-include tests/fixtures/rational-transition-rollback *.json *.va
include tests/fixtures/held-integer29-target-retry.json
include tests/fixtures/factor-topology19-nonbinary-time.json
