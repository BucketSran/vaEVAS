# Harbor tasks contain byte-for-byte copies of the maintained checker modules.
# sync_runtime.py --check verifies these copies; review benchmark/checkers first.
benchmark/tasks/*/tests/circuit_task.py linguist-generated=true
benchmark/tasks/*/tests/adc_linearity.py linguist-generated=true
benchmark/tasks/*/tests/first_batch_*.py linguist-generated=true
benchmark/tasks/*/tests/triangle_oscillator.py linguist-generated=true

# Generated receipts remain expandable; their readable counts live in CALIBRATION.md.
experiments/benchmark_first_batch/calibration_receipt.json linguist-generated=true
experiments/benchmark_first_batch/optimization/*receipt.json linguist-generated=true

# Stored patches keep their original context bytes (receipts bind them by SHA),
# so trailing whitespace in their context lines is content, not a style error.
experiments/backends/support/low-cost-closure/*.patch -whitespace
