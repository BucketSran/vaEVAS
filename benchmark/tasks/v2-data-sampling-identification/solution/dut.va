analog begin
@(initial_step) vinit=V(vin);
if(V(vin)<=0.2) rate=rate0(V(vhold));
else if(V(vin)<=0.3) rate=rate0(V(vhold))+(rate1(V(vhold))-rate0(V(vhold)))*(V(vin)-0.2)/0.1;
else if(V(vin)<=0.5) rate=rate1(V(vhold))+(rate2(V(vhold))-rate1(V(vhold)))*(V(vin)-0.3)/0.2;
else if(V(vin)<=0.6) rate=rate2(V(vhold))+(rate3(V(vhold))-rate2(V(vhold)))*(V(vin)-0.5)/0.1;
else if(V(vin)<=0.9) rate=rate3(V(vhold))+(rate4(V(vhold))-rate3(V(vhold)))*(V(vin)-0.6)/0.3;
else if(V(vin)<=1.1) rate=rate4(V(vhold))+(rate5(V(vhold))-rate4(V(vhold)))*(V(vin)-0.9)/0.2;
else if(V(vin)<=1.2) rate=rate5(V(vhold))+(rate6(V(vhold))-rate5(V(vhold)))*(V(vin)-1.1)/0.1;
else if(V(vin)<=1.4) rate=rate6(V(vhold))+(rate7(V(vhold))-rate6(V(vhold)))*(V(vin)-1.2)/0.2;
else if(V(vin)<=1.5) rate=rate7(V(vhold))+(rate8(V(vhold))-rate7(V(vhold)))*(V(vin)-1.4)/0.1;
else if(V(vin)<=1.6) rate=rate8(V(vhold))+(rate9(V(vhold))-rate8(V(vhold)))*(V(vin)-1.5)/0.1;
else rate=rate9(V(vhold));
gate=transition(V(clock)<0.9 ? 1.0 : 0.0,65p,35p,35p);
V(vhold) <+ idt(gate*(V(vin)-V(vhold))*rate*1e9,vinit);
$bound_step(10p);
end
endmodule
