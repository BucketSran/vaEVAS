    "supported_scope": "pure voltage-domain event-driven transient behavioral Verilog-A",
    "title": "Rail Normalized Metric Mapper"
  },
  "modeling_constraints": [
    "Use deterministic voltage-domain behavioral Verilog-A.",
    "Do not hard-code validation stimulus, stop times, sample windows, gold internals, or simulator side channels."
  ],
  "properties": [
    {
      "id": "P_NORMALIZE_MEAS_RELATIVE_TO_THE_LOCAL",
      "observable_contract": "Let span = V(vdd, vss) and local_meas = V(meas) - V(vss). When V(en) > vth and span >= span_min, drive norm = vhi * clip01(local_meas / span).",
      "required_signals": [
        "time",
        "en",
        "meas",
        "norm",
        "valid",
        "vdd",
        "vss"
      ]
    },
    {
      "id": "P_CLIP_THE_NORMALIZED_METRIC_TO_THE",
      "observable_contract": "clip01(x) limits x to [0, 1], so enabled norm is clipped to [0 V, vhi] even when meas lies outside the local rails.",
      "required_signals": [
        "time",
        "en",
        "meas",
        "norm",
        "valid",
        "vdd",
        "vss"
      ]
    },
    {
      "id": "P_ASSERT_VALID_ONLY_WHEN_ENABLE_IS",
      "observable_contract": "Drive valid = vhi exactly when V(en) > vth, span_min <= span <= span_max, and 0 <= local_meas <= span; otherwise drive valid = 0 V.",
      "required_signals": [
        "time",
        "en",
        "meas",
        "norm",
        "valid",
        "vdd",
        "vss"
      ]
    },
    {
      "id": "P_CLEAR_NORM_AND_VALID_WHILE_DISABLED",
      "observable_contract": "Drive both norm and valid to 0 V while disabled or when span < span_min. A span above span_max clears valid but does not by itself clear clipped norm.",
      "required_signals": [
        "time",
        "en",
        "meas",
        "norm",
        "valid",
        "vdd",
        "vss"
      ]
    },
    {
      "id": "P_USE_LOCAL_ANALOG_HELPER_FUNCTIONS_RATHER",
      "observable_contract": "Use local analog helper functions rather than user task/endtask syntax.",
      "required_signals": [
        "time",
        "en",
        "meas",
        "norm",
        "valid",
        "vdd",
        "vss"
      ]
    }
  ],
