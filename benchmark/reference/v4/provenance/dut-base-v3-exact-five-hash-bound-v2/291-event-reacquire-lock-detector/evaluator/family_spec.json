  "properties": [
    {
      "id": "P_RECORD_REFERENCE_CLOCK_RISING_EDGE_TIME",
      "observable_contract": "A rising ref_clk records $abstime. A reset-low rising fb_clk uses the absolute elapsed time since that reference, or metric_fullscale before any reference edge.",
      "required_signals": [
        "time",
        "fb_clk",
        "lock",
        "phase_metric",
        "ref_clk",
        "rst",
        "state_mon"
      ]
    },
    {
      "id": "P_REQUIRE_CONSECUTIVE_IN_WINDOW_FEEDBACK_EDGE",
      "observable_contract": "A feedback edge with a recorded reference and phase_error <= lock_window increments the good count capped at lock_count; another feedback edge clears it. lock = vhi exactly when the count reaches lock_count.",
      "required_signals": [
        "time",
        "fb_clk",
        "lock",
        "phase_metric",
        "ref_clk",
        "rst",
        "state_mon"
      ]
    },
    {
      "id": "P_CLEAR_LOCK_STATE_AND_PROGRESS_WHEN",
      "observable_contract": "Reset rising or sampled high on a feedback edge clears the good count, lock, phase_metric, and state_mon.",
      "required_signals": [
        "time",
        "fb_clk",
        "lock",
        "phase_metric",
        "ref_clk",
        "rst",
        "state_mon"
      ]
    },
    {
      "id": "P_EXPOSE_PHASE_METRIC_AND_STATE_MON",
      "observable_contract": "After each reset-low feedback edge, phase_metric = vhi * clip01(phase_error / metric_fullscale) and state_mon = vhi * clip01(good_count / lock_count).",
      "required_signals": [
        "time",
        "fb_clk",
        "lock",
        "phase_metric",
        "ref_clk",
        "rst",
        "state_mon"
      ]
    },
    {
      "id": "P_USE_EVENT_BODY_STATE_UPDATES_PLUS",
      "observable_contract": "Use event-body state updates plus local analog helper functions rather than user task/endtask syntax.",
      "required_signals": [
        "time",
        "fb_clk",
        "lock",
        "phase_metric",
        "ref_clk",
        "rst",
        "state_mon"
      ]
    }
  ],
