//--------------------
// level_shifter
//
// -  level shifter
//
// sigin:	(val,flow)
// sigout:	(val,flow)
//
// INSTANCE parameters
//    sigshift = level shift (val)
//
// MODEL parameters
//    {none}
//
// 'sigout' = 'sigin' added to 'sigshift'
//

module level_shifter(sigin, sigout);
input sigin;
output sigout;
electrical sigin, sigout;
parameter real sigshift = 0;

   analog
      V(sigout) <+ V(sigin) + sigshift;

endmodule






