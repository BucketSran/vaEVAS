//--------------------
// differentiator
//
// -  differentiator
//
// sigin:	(val,flow)
// sigout:	(val,flow)
//
// INSTANCE parameters
//    gain = []
//
// MODEL parameters
//    {none}
//

module differentiator(sigin, sigout);
input sigin;
output sigout;
electrical sigin, sigout;
parameter real gain = 1;

   analog 
      V(sigout) <+ gain * ddt(V(sigin));

endmodule





