//--------------------
// integrator
//
// -  integrator
//
// sigin:	(val,flow)
// sigout:	(val,flow)
//
// INSTANCE parameters
//    sigout0 = initial sigout value (val)
//    gain    = []
//
// MODEL parameters
//    {none}
//

module integrator(sigin, sigout);
input sigin;
output sigout;
electrical sigin, sigout;
parameter real sigout0 = 0;
parameter real gain = 1;

   analog
   	V(sigout) <+ gain*idt(V(sigin), 0) + sigout0;

endmodule






