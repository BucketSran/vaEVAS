//--------------------
// repeater
//
// -  repeater
//
// sigin:	(val,flow)
// sigout:	(val,flow)
//
// INSTANCE parameters
//    period = period of repeated waveform (val)
//
// MODEL parameters
//    {none}
//
// From 0 to 'period', 'sigout' = 'sigin'. After this the 'sigout' is a
// periodic repetition of what 'sigin' was between 0 and 'period'.
//
(* instrument_module *)
module repeater(sigin, sigout);
input sigin;
output sigout;
electrical sigin, sigout;
parameter real period = 1n;

electrical gnd, delayout, delayin; 
ground gnd;
\delay #(.td(period)) delay1(delayout, gnd, delayin, gnd);
   analog begin
     if ($abstime <= period) begin
        V(sigout) <+ V(sigin);
        V(delayin) <+ V(sigin);
     end else begin
        V(delayin) <+ V(sigout);
        V(sigout) <+ V(delayout);
     end
   end
endmodule







