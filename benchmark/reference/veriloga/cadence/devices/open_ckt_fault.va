//--------------------
// open_ckt_fault
//
// -  open circuit fault
//
// vp,vn:		output terminals [V,A]
//
// INSTANCE parameters
//    twait = time to wait before open fault happens [s]
//
// MODEL parameters
//    {none}
//
// At time='twait', the connection between the two terminals is opened. Before
// this the connection between the terminals is closed.
//

module open_ckt_fault(vp, vn);
inout vp, vn;
electrical vp, vn;
parameter real twait = 0.3m;
   analog begin
      if ($abstime < twait)begin
      	 V(vp,vn) <+ 0.0 ;
      end
      else begin
      	 I(vp,vn) <+ 0.0;
      end
   end
endmodule







