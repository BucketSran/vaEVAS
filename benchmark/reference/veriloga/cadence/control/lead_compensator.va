//--------------------
// lead_compensator
//
// -  lead compensator
//
// sigin:	(val,flow)
// sigout:	(val,flow)
//
// INSTANCE parameters
//    gain  = compensator gain []
//    tau   = compensator zero at -(1/tau) [s]
//    alpha = compensator pole at -(1/(alpha*tau)); alpha < 1 []
//
// MODEL parameters
//    {none}
//
//                         1      +         'tau' * S
// TF:  'gain'* 'alpha' * ----------------------------
//                         1      + alpha * 'tau' * S
//
// NOTE
//    Defining larger values of 'abstol' and 'huge' for the quantities
//    associated with sigin and sigout can help overcome convergence and
//    clipping problems.
//

module lead_compensator(sigin, sigout);
input sigin;
output sigout;
electrical sigin, sigout;
parameter real gain  = 1 from (0:inf);
parameter real tau   = 1 from [0:inf);
parameter real alpha = 0.1 from (0:1);

   real integ_gain;
   real sigin_gain;

   analog begin
      @ ( initial_step or initial_step( "dc" ) or initial_step( "ac" )) begin
         integ_gain = 1/alpha/tau;
         sigin_gain = gain*alpha;
      end
      V(sigout) <+ integ_gain * idt(sigin_gain*V(sigin) - V(sigout),0)
                     + gain * V(sigin);
   end
endmodule





