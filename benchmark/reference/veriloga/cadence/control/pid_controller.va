//--------------------
// pid_controller
//
// -  proportional, integral and derivative controller
//
// sigin:	(V,I)
// sigout:	(V,I)
//
// INSTANCE parameters
//    kp = proportional gain []
//    ki = integral gain []
//    kd = differential gain []
//
// MODEL parameters
//    {none}
//
// 'sigout' = 'kp' * sigin + 'ki' * idt ('sigin') + 'kd'* ddt ('sigin')
//
// NOTE
//    Defining larger values of 'abstol' and 'huge' for the quantities
//    associated with sigin and sigout can help overcome convergence and
//    clipping problems.
//

module pid_controller(sigin, sigout);
input sigin;
output sigout;
electrical sigin, sigout;
parameter real kp = 1 from [0:inf);
parameter real ki = 0 from [0:inf);
parameter real kd = 0 from [0:inf);

   analog 
      V(sigout) <+ kp * V(sigin) + kd * ddt (V(sigin))
                       + ki * idt (V(sigin),0);
endmodule





