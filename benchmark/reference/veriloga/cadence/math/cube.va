//--------------------
// cube
//
// -  cube
//
// sigin:	(val,flow)
// sigout:	(val,flow)
//
// INSTANCE parameters
//    {none}
//
// MODEL parameters
//    {none}
//
// 'sigout' is the cube of the 'sigin'
//

module cube (sigin, sigout);
input sigin;
output sigout;
electrical sigin, sigout;

   analog 
      V(sigout) <+ V(sigin) * V(sigin) * V(sigin);

endmodule


