//--------------------
// absolute_value
//
// -  absolute value
//
// sigin:	(val,flow)
// sigout:	(val,flow)
//
// INSTANCE parameters
//    {none}
//
// MODEL parameters
//    {none}
//
// 'sigout' is the absolute value of 'sigin'
//

module absolute_value(sigin, sigout);
input sigin;
output sigout;
electrical sigin, sigout;

   analog
      V(sigout) <+ abs(V(sigin));

endmodule






