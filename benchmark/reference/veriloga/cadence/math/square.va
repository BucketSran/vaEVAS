//--------------------
// square
//
// -  square
//
// sigin:	input
// sigout:	output
//
// INSTANCE parameters
//    {none}
//
// MODEL parameters
//    {none}
//
// 'sigout' is the square of the 'sigin'
//

module square (sigin, sigout);
input sigin;
output sigout;
electrical sigin, sigout;

   analog 
      V(sigout) <+ V(sigin) * V(sigin);

endmodule
