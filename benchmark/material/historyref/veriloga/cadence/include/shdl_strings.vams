 * ............................................................................
 *      The P1800 standard does not contain equivalents for all the SpectreHDL string operators and functions. Hence a verilog-ams file, shdl_strings.vams, is provided in the installation that contains Verilog-A user defined functions that address the missing equivalents. Users can use these as examples, directly copy the required function into their module.
 
 *      Its location in the installation is <mmsim installation path>/tools/spectre/etc/ahdl/shdl_strings.vams
 *
 */

analog function integer shdl_strstr;    //Return first position where str_sub is found in str.
    input str_ori, str_sub;

    string str_ori, str_sub, str_tmp;

    integer len_ori;

    integer len_sub;

    integer found;

    integer flag;

    integer i;

    begin

        len_ori = str_ori.len();

        len_sub = str_sub.len();

        found = 0;
   
        i = 0;

        flag = 0;

        if (len_ori < len_sub) 

            begin
              $strobe( "Error from shdl_strstr in shdl_strings.va: Length of the first argument should be larger than the second argument's length.\n");
            end
        else
            for ( i = 0; i<=len_ori-len_sub ; i =i+1)
                begin
                        str_tmp = str_ori.substr(i, i+len_sub-1);
                    if (str_tmp == str_sub) begin
                        flag = 1;
                        found = i;
                        i=len_ori;   // Break the loop.
                    end
                end
        shdl_strstr = flag? found : -1 ;
    end
endfunction

analog function integer shdl_strchr;    //Return first position where the first instance of a character occurs in a string.
    input str_ori, str_sub;
                                                                                
    string str_ori, str_sub, str_tmp;
                                                                                
    integer len_ori;
                                                                                
    integer len_sub;

    integer found;

    integer flag;
                                                                                
    integer i;
                                                                                
    begin
                                                                                
        len_ori = str_ori.len();

        len_sub = str_sub.len();
                                                                                
        found = 0;
                                                                                
        flag = 0;

        i = 0;
                                                                                
        if (len_ori < len_sub)

            begin
              $strobe( "Error from shdl_strchr in shdl_strings.va: Length of the first argument should be larger than the second argument's length.\n");
            end
        else if ( len_sub !=1 )
            begin
              $strobe( "Error from shdl_strchr in shdl_strings.va: The second argument should be a string with length as 1.\n");
            end
        else
            for ( i = 0; i<len_ori; i =i+1)
                begin
                    str_tmp = str_ori.substr(i, i);
                    if (str_tmp == str_sub)
                        begin
                            flag = 1;
                            found = i;
                            i=len_ori; // Break the loop.
                        end
                end
        shdl_strchr = flag ? found : -1 ;
    end
                                                                                
endfunction

analog function integer shdl_strrchr;    //Return last position where the first instance of a character occurs in a string.
    input str_ori, str_sub;
                                                                                
    string str_ori, str_sub, str_tmp;
                                                                                
    integer len_ori;
                                                                                
    integer len_sub;

    integer found;
                                                                                
    integer flag;

    integer i;
                                                                                
    begin
                                                                                
        len_ori = str_ori.len();

        len_sub = str_sub.len();
                                                                                
        found = 0;

        flag = 0;
                                                                                
        i = 0;
                                                                                
        if (len_ori < len_sub)
            begin
                $strobe( "Error from shdl_strrchr in shdl_strings.va: Length of the first argument should be larger than the second argument's length.\n");
            end

        else if ( len_sub !=1 )
            begin
                $strobe( "Error from shdl_strrchr in shdl_strings.va: The second argument should be a string with length as 1.\n");
            end
        else
            for ( i = 0; i<len_ori; i =i+1)
                begin
                    str_tmp = str_ori.substr(i, i);
                    if (str_tmp == str_sub) begin
                        found = i;
                        flag = 1;
                    end
                end
        shdl_strrchr = flag? found : -1 ;
    end
                                                                                
endfunction

analog function integer shdl_strspn;    //Count sequences of a set of characters in a particular string.
    input str_sub, str_spn;
                                                                                
    string str_spn, str_sub, str_tmp, str_tmq;
                                                                                
    integer len_spn;
                                                                                
    integer len_sub;

    integer found;

    integer flag;
                                                                                
    integer i;
                                                                                
    begin

        len_spn = str_spn.len();

        len_sub = str_sub.len();
                                                                                
        found = 0;

        flag = 0;
                                                                                
        for ( i = 0; i<len_sub; i =i+1)

           begin
               str_tmp = str_sub.substr(i, i);
 
               if (shdl_strchr(str_spn, str_tmp)>=0)
                   begin
                       flag = 1;
                       found = found + 1;
                   end
               else if (found > 0) 
                   begin
                       i = len_sub;    // Break out of the for-loop.
                   end
               else begin
                        found = 0;
                        i = len_sub;    // Break out of the for-loop.
                    end
           end

        shdl_strspn = flag? found : 0 ;
    end
                                                                                
endfunction

analog function integer shdl_strcspn;    //Count sequences of a set of characters not in a particular string.
    input str_sub, str_spn;
                                                                                
    string str_spn, str_sub, str_tmp, str_tmq;
                                                                                
    integer len_spn;
                                                                                
    integer len_sub;

    integer found;
                                                                                
    integer flag;

    integer i;
                                                                                
    begin
                                                                                
      len_spn = str_spn.len();

      len_sub = str_sub.len();
                                                                                
      found = 0;
                                                                                
      flag = 0;

      for ( i = 0; i<len_sub; i =i+1)
          begin
              str_tmp = str_sub.substr(i, i);
              if (shdl_strchr(str_spn, str_tmp) < 0) 
                  begin
                      flag = 1;
                      found = i+1;
                  end
              else if (found > 0)
                  i = len_sub;    // Break the loop.
              else begin
                      found = 0;
                      i = len_sub;    // Break the loop.
                   end
          end
      shdl_strcspn = flag? found : 0 ;
    end
endfunction
