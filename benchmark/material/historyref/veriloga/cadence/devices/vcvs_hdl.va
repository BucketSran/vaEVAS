//--------------------
// vcvs_hdl
//
// -  voltage controlled voltage source
//
// vout_p,vout_n:	controlled voltage terminals  [V,A]
// vin_p,vin_n:		controlling voltate terminals [V,A]
//
// INSTANCE parameters
//    gain = voltage gain []
//
// MODEL parameters
//    {none}
//

module vcvs_hdl(vout_p, vout_n, vin_p, vin_n);
input vin_p, vin_n;
output vout_p, vout_n;
electrical vout_p, vout_n, vin_p, vin_n;
parameter real gain = 0;

   analog
      V(vout_p, vout_n) <+ gain*V(vin_p, vin_n);

endmodule







