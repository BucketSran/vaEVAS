//--------------------
// res
//
// -  resistor
//
// vp,vn:	terminals (V,A)
//
// INSTANCE parameters
//    r = resistance (Ohms)
//
// MODEL parameters
//    {none}
//

module res(vp, vn);
inout vp, vn;
electrical vp, vn;
parameter real r = 0;

   analog
      V(vp, vn) <+ r*I(vp, vn);

endmodule







