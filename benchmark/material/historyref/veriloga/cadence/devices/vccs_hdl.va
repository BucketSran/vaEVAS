//--------------------
// vccs_hdl
//
// -  voltage controlled current source
//
// iout_p,iout_n:	controlled current source terminals [V,A]
// vin_p,vin_n:		controlling voltage terminals       [V,A]
//
// INSTANCE parameters
//    gm = conductance multiplier (V to I gain) [Mhos]
//
// MODEL parameters
//    {none}
//

module vccs_hdl(iout_p, iout_n, vin_p, vin_n);
input vin_p, vin_n;
output iout_n, iout_p;
electrical iout_n, iout_p, vin_p, vin_n;
parameter real gm = 0;

   analog
      I(iout_p, iout_n) <+ gm*V(vin_p, vin_n);

endmodule







