//--------------------
// signum
//
// -  signum - sign of the input
//
// sigin:	(val,flow)
// sigout:	(val,flow)
//
// INSTANCE parameters
//    {none}
//
// MODEL parameters
//    {none}
//
// 'sigout' is '+1' if 'sigin' >= 0 otherwise 'sigout' is '-1'
//

module signum (sigin, sigout);
input sigin;
output sigout;
electrical sigin, sigout;

   analog
      V(sigout) <+ V(sigin) >= 0.0 ? 1 : -1; 

endmodule
