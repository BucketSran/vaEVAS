//--------------------
// subtractor
//
// -  subtractor
//
// sigin_p:	input subtracted from   (val,flow)
// sigin_n:	input that's subtracted (val,flow)
// sigout:	(val,flow)
//
// INSTANCE parameters
//    {none}
//
// MODEL parameters
//    {none}
//

module subtractor(sigin_p, sigin_n, sigout);
input sigin_p, sigin_n;
output sigout;
electrical sigin_p, sigin_n, sigout;

   analog
      V(sigout) <+ V(sigin_p, sigin_n);

endmodule





