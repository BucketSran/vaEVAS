simulator lang=spectre
global 0
ahdl_include "dut.va"
Vinput (vin 0) vsource type=pwl wave=[0 -0.65 0.000127989999 -0.65 0.00012799 0.5 0.000152 0.5]
Vtrack (track 0) vsource type=pwl wave=[0 1 7.9999995e-06 1 8.0000005e-06 0 0.0001279999995 0 0.0001280000005 1 0.000152 1]
DUT (vin track out) identified_sh
simulatorOptions options reltol=1e-7 vabstol=1e-10 iabstol=1e-13
tran tran stop=0.000152 maxstep=2e-8 errpreset=conservative
save out vin track
