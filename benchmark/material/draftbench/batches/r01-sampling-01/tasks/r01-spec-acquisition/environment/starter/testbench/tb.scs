simulator lang=spectre
global 0
simulatorOptions options reltol=1e-6 vabstol=1e-9 iabstol=1e-15
ahdl_include "../circuit.va"
V_vin (vin 0) vsource type=pwl wave=[0 0.3 7.5e-08 0.3 7.52e-08 1.6 1.55e-07 1.6 1.552e-07 0.2 3.3e-07 0.2 3.302e-07 1.1 4.7e-07 1.1 4.702e-07 0.55 7.9e-07 0.55 7.902e-07 1.45]
V_rst (rst 0) vsource type=pwl wave=[0 0 3.5e-07 0 3.502e-07 1.8 3.64e-07 1.8 3.642e-07 0 6.2e-07 0 6.202e-07 1.8 6.34e-07 1.8 6.342e-07 0]
V_track (track 0) vsource type=pwl wave=[0 0 3e-08 0 3.02e-08 1.8 4.5e-08 1.8 4.52e-08 0 1e-07 0 1.002e-07 1.8 1.08e-07 1.8 1.082e-07 0 1.4e-07 0 1.402e-07 1.8 1.45e-07 1.8 1.452e-07 0 2.05e-07 0 2.052e-07 1.8 2.45e-07 1.8 2.452e-07 0 3.4e-07 0 3.402e-07 1.8 3.75e-07 1.8 3.752e-07 0 4.5e-07 0 4.502e-07 1.8 5.2e-07 1.8 5.202e-07 0 7.8e-07 0 7.802e-07 1.8 8.25e-07 1.8 8.252e-07 0]
X_DUT (vin track rst vout) track_hold vinit=0.8 tau_acq=1e-08 tau_reset=2e-09 acq_curvature=0.6 vmid=0.9 vscale=0.9
tran tran stop=9e-07 maxstep=100p errpreset=conservative
save vin rst track vout
